# ══════════════════════════════════════════════════════════════════
# RevRec — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. This file (.env.example) IS safe to commit.
# ══════════════════════════════════════════════════════════════════

# ─── Node ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── PostgreSQL ───────────────────────────────────────────────────
# Connection string used by Prisma
DATABASE_URL="postgresql://revrec_user:revrec_pass@localhost:5432/revrec_db?schema=public"

# ─── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Webhook Security ─────────────────────────────────────────────
# Secret used to verify HMAC-SHA256 signatures on incoming webhooks.
# In production this must be a cryptographically random 64-char hex string.
WEBHOOK_SECRET=change_me_to_a_64_char_random_hex_string

# ─── AI / LLM ─────────────────────────────────────────────────────
# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use for recovery agent reasoning
GEMINI_MODEL=gemini-2.5-flash

# Maximum tokens the agent can use per recovery decision (cost control)
GEMINI_MAX_TOKENS=1024

# ─── Dunning / Compliance Limits ─────────────────────────────────
# Maximum outreach attempts per customer per 7-day rolling window (RBI-aligned)
DUNNING_MAX_ATTEMPTS_PER_WEEK=3

# Mandatory cooling-off period between two consecutive contact attempts (in hours)
DUNNING_COOLING_OFF_HOURS=48

# Maximum total retry attempts for a single payment before escalating to human
PAYMENT_MAX_RETRY_ATTEMPTS=5

# ─── Frontend ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
