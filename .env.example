# --- RevRec Environment Configuration Template -------------------------------

# Environment mode (development | test | production)
NODE_ENV=development
PORT=3001

# Database connection URL (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revrec?schema=public"

# Redis connection (General client & BullMQ delayed queues)
REDIS_URL="redis://localhost:6379"

# Razorpay Webhook Secret (Matches signature in X-Razorpay-Signature header)
WEBHOOK_SECRET="whsec_razorpay_live_secret_2026"

# AI Inference Engine (Groq LPU)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Optional Razorpay API credentials for live link creation & order generation
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
