    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@bull-board/api": "^9.6.1",
    "@bull-board/express": "^9.6.1",
    "@google/genai": "^2.19.0",
    "@revrec/db": "*",
    "@revrec/types": "*",
    "bullmq": "^5.12.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "ioredis": "^5.4.1",
    "razorpay": "^2.9.8",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
