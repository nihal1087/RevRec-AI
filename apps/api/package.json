{
  "name": "@revrec/api",
  "version": "1.0.0",
  "private": true,
  "description": "RevRec API — Express.js backend for the Revenue Recovery Engine",
  "main": "dist/apps/api/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "build:web": "echo ok",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
