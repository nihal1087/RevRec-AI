// ══════════════════════════════════════════════════════════════════
// RevRec — Prisma Database Schema
// This is the single source of truth for ALL database structure.
// Never modify the database directly — always go through migrations.
// ══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeclineCategory {
  SOFT
  HARD
  NETWORK
  INTENT_DROP
  MANDATE_FAILURE
}

enum RecoveryStage {
  PENDING
  ANALYZING
  RETRYING
  OUTREACH_SENT
  PROMISE_RECEIVED
  RECOVERED
  ESCALATED
  HALTED
  ABANDONED
}

enum DunningChannel {
  WHATSAPP
  SMS
  EMAIL
  HINGLISH_VOICE
  HUMAN_AGENT
}

enum RecoveryMethod {
  AUTO_RETRY
  CUSTOMER_LINK_CLICK
  PROMISE_TO_PAY_FULFILLED
  PARTIAL_SETTLEMENT
  MANUAL_HUMAN
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
  EXPIRED
}

enum MandateType {
  ENACH
  UPI_AUTOPAY
  CARD
}

enum PromiseStatus {
  ACTIVE
  FULFILLED
  BREACHED
  CANCELLED
}

enum AuditEventType {
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_RETRY_SCHEDULED
  PAYMENT_RETRY_SUCCEEDED
  PAYMENT_RETRY_FAILED
  WORKFLOW_CREATED
  WORKFLOW_STAGE_CHANGED
  WORKFLOW_RECOVERED
  WORKFLOW_ABANDONED
  WORKFLOW_HALTED
  WORKFLOW_ESCALATED
  RCA_CLASSIFIED
  AGENT_DECISION_MADE
  AGENT_TOOL_EXECUTED
  AGENT_REJECTED_BY_POLICY
  OUTREACH_SENT
  OUTREACH_DELIVERED
  CUSTOMER_RESPONDED
  PROMISE_TO_PAY_CREATED
  PROMISE_TO_PAY_FULFILLED
  PROMISE_TO_PAY_BREACHED
  COMPLIANCE_CHECK_PASSED
  COMPLIANCE_CHECK_FAILED
  MAX_ATTEMPTS_REACHED
}

// CUSTOMER
model Customer {
  id                  String         @id @default(uuid())
  externalId          String         @unique
  name                String
  email               String
  phone               String
  riskScore           Int            @default(50)
  riskTier            String         @default("LOW")
  paymentHistoryScore Int            @default(85)
  // Fix L1: BigInt — Int max is ~Rs 2.1Cr; high-value B2B customers exceed this
  ltvInPaise          BigInt         @default(0)
  preferredChannel    DunningChannel @default(WHATSAPP)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  payments          Payment[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  recoveryWorkflows RecoveryWorkflow[]
  dunningContacts   DunningContact[]
  promiseToPays     PromiseToPay[]
  auditLogs         AuditLog[]       // Fix M12: added FK back-relation

  // Fix L1: removed @@index([externalId]) - redundant with @unique
  @@index([email])
}

// PAYMENT
model Payment {
  id               String           @id @default(uuid())
  externalId       String           @unique
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])
  subscriptionId   String?
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id])
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  // Fix L1: BigInt — enterprise payments can exceed Rs 2.1Cr Int limit
  amountInPaise    BigInt
  currency         String           @default("INR")
  status           PaymentStatus    @default(PENDING)
  gateway          String
  gatewayErrorCode String?
  declineCategory  DeclineCategory?
  idempotencyKey   String           @unique
  version          Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  recoveryWorkflow RecoveryWorkflow?
  auditEntries     AuditLog[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  // Fix L1: removed @@index([externalId]) - redundant with @unique
}

// SUBSCRIPTION
model Subscription {
  id              String             @id @default(uuid())
  externalId      String             @unique
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  planName        String
  // Fix L1: BigInt
  amountInPaise   BigInt
  currency        String             @default("INR")
  status          SubscriptionStatus @default(ACTIVE)
  mandateType     MandateType
  nextBillingDate DateTime
  failedAttempts  Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

// INVOICE
model Invoice {
  id                String        @id @default(uuid())
  externalId        String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  // Fix L1: BigInt
  amountInPaise     BigInt
  paidAmountInPaise BigInt        @default(0)
  currency          String        @default("INR")
  status            InvoiceStatus @default(DRAFT)
  dueDate           DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// RECOVERY WORKFLOW
model RecoveryWorkflow {
  id                     String          @id @default(uuid())
  paymentId              String          @unique
  payment                Payment         @relation(fields: [paymentId], references: [id])
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  // Fix L1: BigInt
  amountAtRiskInPaise    BigInt
  amountRecoveredInPaise BigInt          @default(0)
  currency               String          @default("INR")
  stage                  RecoveryStage   @default(PENDING)
  retryCount             Int             @default(0)
  outreachCount          Int             @default(0)
  recoveryMethod         RecoveryMethod?
  haltReason             String?
  escalationReason       String?
  nextActionAt           DateTime?
  expiresAt              DateTime
  version                Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  dunningContacts  DunningContact[]
  promiseToPays    PromiseToPay[]
  auditEntries     AuditLog[]
  agentExecutions  AgentExecution[]

  @@index([customerId])
  @@index([stage])
  @@index([nextActionAt])
  @@index([expiresAt])
}

// DUNNING CONTACT LOG
model DunningContact {
  id               String           @id @default(uuid())
  workflowId       String
  workflow         RecoveryWorkflow @relation(fields: [workflowId], references: [id])
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])
  channel          DunningChannel
  messageTemplate  String
  sentAt           DateTime         @default(now())
  deliveredAt      DateTime?
  openedAt         DateTime?
  clickedAt        DateTime?
  customerResponse String?

  @@index([workflowId])
  @@index([customerId])
  @@index([customerId, sentAt])
}

// PROMISE TO PAY
model PromiseToPay {
  id                    String           @id @default(uuid())
  workflowId            String
  workflow              RecoveryWorkflow @relation(fields: [workflowId], references: [id])
  customerId            String
  customer              Customer         @relation(fields: [customerId], references: [id])
  // Fix L1: BigInt
  promisedAmountInPaise BigInt
  currency              String           @default("INR")
  promisedByDate        DateTime
  status                PromiseStatus    @default(ACTIVE)
  createdByChannel      DunningChannel
  reminderScheduledAt   DateTime?
  fulfilledAt           DateTime?
  breachedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([workflowId])
  @@index([status])
  @@index([promisedByDate, status])
}

// AUDIT LOG — Immutable Append-Only Ledger
model AuditLog {
  id            String            @id @default(uuid())
  eventType     AuditEventType
  workflowId    String?
  workflow      RecoveryWorkflow? @relation(fields: [workflowId], references: [id])
  paymentId     String?
  payment       Payment?          @relation(fields: [paymentId], references: [id])
  // Fix M12: proper FK relation (was bare String? with no referential integrity)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  actorType     String
  actorId       String
  payload       Json
  previousStage String?
  newStage      String?
  // Fix L1: BigInt
  amountInPaise BigInt?
  outcome       String
  errorMessage  String?
  checksum      String?
  createdAt     DateTime          @default(now())

  @@index([workflowId])
  @@index([paymentId])
  @@index([customerId])
  @@index([eventType])
  @@index([createdAt])
}

// AGENT EXECUTION — AI Decision Trail
enum AgentExecutionStatus {
  EXECUTED
  REJECTED_BY_POLICY
  EXECUTION_FAILED
  SKIPPED_TERMINAL_STAGE
}

model AgentExecution {
  id                   String                @id @default(uuid())
  workflowId           String
  workflow             RecoveryWorkflow      @relation(fields: [workflowId], references: [id])
  reasoning            String                @db.Text
  selectedTool         String
  toolInput            Json
  confidenceScore      Float
  policyCheckPassed    Boolean
  policyCheckDetails   String
  executionStatus      AgentExecutionStatus
  executionError       String?
  llmLatencyMs         Int
  llmTokensUsed        Int
  // Fix M11: Float instead of Int — LLM costs are sub-paisa (e.g. 0.23 paise/call)
  estimatedCostInPaise Float                 @default(0)
  createdAt            DateTime              @default(now())

  @@index([workflowId])
  @@index([createdAt])
}
